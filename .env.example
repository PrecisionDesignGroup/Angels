# copy to .env and fill in. with no keys the site runs in demo mode.

# google lens image search across the web — https://serpapi.com (free tier available)
SERPAPI_KEY=

# etsy open api v3 — https://www.etsy.com/developers/your-apps
# gives live price + quantity (the stock number) for etsy listings
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# google lens must be able to download your photo. set ONE of these:
#   PUBLIC_URL    — the public address this site is deployed at, e.g. https://angels.example.com
#   IMGBB_API_KEY — free temporary image hosting, https://api.imgbb.com (photos expire after 10 min)
PUBLIC_URL=
IMGBB_API_KEY=

# PORT=3000
# COUNTRY=us
